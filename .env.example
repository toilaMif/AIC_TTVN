# Sao chép file này thành .env trước khi chạy hệ thống.
# Không commit file .env hoặc thông tin đăng nhập thật lên GitHub.

# ===== Backend =====
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ===== Dữ liệu local =====
# Cấu hình mặc định lưu dữ liệu trong .runtime để chạy được trên mọi máy.
# Với artifact Kaggle lớn, nên đổi các đường dẫn này sang ổ dữ liệu riêng,
# ví dụ: D:/AIC_TTVN_DATA/postgres.
AIC_DATA_ROOT=./.runtime
AIC_POSTGRES_ROOT=./.runtime/postgres
AIC_MINIO_ROOT=./.runtime/minio
AIC_MILVUS_ROOT=./.runtime/milvus
AIC_ETCD_ROOT=./.runtime/etcd
AIC_KAGGLE_ARTIFACT_ROOT=./.runtime/artifacts/kaggle
AIC_KAGGLE_BATCH=l21

# ===== PostgreSQL =====
POSTGRES_DB=aic_ttvn
POSTGRES_USER=aic_app
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_HOST_PORT=55432

# ===== MinIO =====
MINIO_ROOT_USER=aic_admin
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Milvus =====
MILVUS_PORT=19530

# ===== Kaggle MCP (không bắt buộc khi chỉ chạy ứng dụng) =====
# Tạo token tại https://www.kaggle.com/settings rồi điền vào file .env cá nhân.
KAGGLE_TOKEN=
