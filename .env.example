# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên git

# ===== MCP / Kaggle =====
# Token cho Kaggle MCP server (dùng trong .mcp.json)
# Tạo tại: https://www.kaggle.com/settings → API → Create New Token
KAGGLE_TOKEN=

# ===== Backend =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# DATABASE_URL=postgresql://user:pass@localhost:5432/db

# ===== AI =====
# Device: cpu | cuda
AI_DEVICE=cpu
# Tên model CLIP (xem ai/config.yaml)
CLIP_MODEL=ViT-B-32
# OPENAI_API_KEY=

# ===== Frontend =====
VITE_API_URL=http://localhost:8000
